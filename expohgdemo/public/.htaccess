# Hostico / Apache — keep this file in public_html so the 404
# setting is not lost when you overwrite the site files.
#
# In Hostico cPanel → Error Pages, you can leave defaults;
# this directive is enough if ErrorDocument is allowed.

Options -Indexes
DirectoryIndex index.html

# Prefer prerendered route folders (e.g. /about/index.html) when present.
# Fall back to the SPA shell for unknown client-side routes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite the custom error documents
  RewriteRule ^404\.shtml$ - [L]
  RewriteRule ^general-error\.shtml$ - [L]

  # Existing files and directories as-is (covers prerendered */index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Custom error pages (Hostico often uses ErrorDocument; this survives deploys)
ErrorDocument 404 /404.shtml
ErrorDocument 500 /general-error.shtml
ErrorDocument 502 /general-error.shtml
ErrorDocument 503 /general-error.shtml
ErrorDocument 504 /general-error.shtml
